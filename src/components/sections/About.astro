---
// About section: the business's story — framed image + text with a drop cap.
import { SITE } from "../../config/site";

const { about } = SITE;

const links: Record<string, string> = about.links;
const hasLinks = links != null && links != undefined && Object.keys(links).length > 0;

function replaceLink(paragraph: string, replacer: string, link: string) {
  let containsLink = paragraph.includes(replacer)
  if (containsLink){
    const index = paragraph.indexOf(replacer)
    let before = paragraph.slice(0, index)
    let after = paragraph.slice(index + replacer.length)
    return `${before}<a href="${link}">${replacer}</a>${after}`
  }
  return paragraph;
}

let paragraphs: ArrayLike<string|Object>
if (hasLinks) {
  for (const [replacer, link] of Object.entries(links)) {
    paragraphs = about.paragraphs.map((paragraph) => replaceLink(paragraph, replacer, link));
  };
}
else {
  paragraphs = about.paragraphs
}

---

<section id="about" class="section section-alt">
  <div class="container about-grid">
    <figure class="about-figure reveal">
      <img
        src={about.image}
        alt={about.imageAlt}
        class="about-image"
        width="520"
        height="390"
        loading="lazy"
      />
    </figure>
    <div class="about-text reveal">
      {about.eyebrow && <p class="section-eyebrow">{about.eyebrow}</p>}
      <h2>{about.title}</h2>{paragraphs.map((paragraph) => (<p set:html={paragraph} />))}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: calc(var(--space-4) * 1.3);
    align-items: center;
  }

  .about-figure {
    position: relative;
    margin: 0;
  }

  .about-image {
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
    width: 100%;
    object-fit: cover;
  }

  /* Decorative offset shapes behind the image */
  .about-figure::before {
    content: "";
    position: absolute;
    inset: -16px auto auto -16px;
    width: 110px;
    height: 110px;
    border-radius: var(--radius);
    background: var(--gradient-accent);
    opacity: 0.16;
    z-index: -1;
  }

  .about-figure::after {
    content: "";
    position: absolute;
    inset: auto -16px -16px auto;
    width: 150px;
    height: 150px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    z-index: -1;
  }

  /* Editorial drop cap on the first paragraph */
  .about-text p:first-of-type::first-letter {
    font-family: var(--font-heading);
    font-size: 3.2em;
    float: left;
    line-height: 0.82;
    padding-right: 0.12em;
    color: var(--color-accent);
  }
</style>
